{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/index.css"
  ],
  "exclude": [
    "archive/**",
    "src/guitarist-main.tsx",
    "src/GuitaristApp.tsx",
    "src/guitarist.css",
    "src/apps/StelaDashboardApp.tsx",
    "src/lib/stelaApi.ts"
  ]
}
