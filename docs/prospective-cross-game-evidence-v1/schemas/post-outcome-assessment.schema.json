{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asp.local/schemas/ASP_PROSPECTIVE_FORECAST_ASSESSMENT_V1.json",
  "title": "ASP prospective post-outcome assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "sport", "canonicalGameId", "preOutcomeEvidenceSha256", "scoredForecast", "finalResult", "outcomeAvailableAt", "assessmentCapturedAt", "assessmentDisposition", "exclusionReason", "frozenGateSegments", "frozenGateBinding"],
  "properties": {
    "schemaVersion": {"const": "ASP_PROSPECTIVE_FORECAST_ASSESSMENT_V1"},
    "assessmentId": {"type": "string", "minLength": 1},
    "sport": {"enum": ["MLB", "NFL", "NBA", "CFB", "MMA"]},
    "canonicalGameId": {"type": "string", "minLength": 1},
    "preOutcomeEvidenceSha256": {"$ref": "#/$defs/sha256"},
    "scoredForecast": {"type": "object", "additionalProperties": false, "required": ["forecastId", "forecastRevision", "packageSha256"], "properties": {"forecastId": {"type": "string", "minLength": 1}, "forecastRevision": {"type": "integer", "minimum": 1}, "packageSha256": {"$ref": "#/$defs/sha256"}}},
    "finalResult": {
      "type": "object", "additionalProperties": false, "required": ["resultId", "revision", "status", "participantResults", "resultSha256"],
      "properties": {"resultId": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "status": {"const": "FINAL"}, "participantResults": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["canonicalParticipantId", "outcome", "score"], "properties": {"canonicalParticipantId": {"type": "string", "minLength": 1}, "outcome": {"enum": ["WIN", "LOSS", "TIE", "DRAW", "NO_CONTEST"]}, "score": {"type": ["number", "null"]}}}}, "resultSha256": {"$ref": "#/$defs/sha256"}}
    },
    "outcomeAvailableAt": {"$ref": "#/$defs/timestamp"},
    "assessmentCapturedAt": {"$ref": "#/$defs/timestamp"},
    "assessmentDisposition": {"enum": ["INCLUDED", "EXCLUDED"]},
    "exclusionReason": {"type": ["string", "null"]},
    "frozenGateSegments": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "frozenGateBinding": {"type": "object", "additionalProperties": false, "required": ["designSha256", "resultsSha256"], "properties": {"designSha256": {"const": "5749b2457b52589a612b3a2597341185a5baf9b814d300715ec115a4c8dda87f"}, "resultsSha256": {"const": "fafc0b9bd9997e65fa6db209bceb6dacb91943528e136ed23603daf922ffef24"}}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"}}
}
