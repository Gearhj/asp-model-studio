    "python": "import numpy as np\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import roc_auc_score\n\nX = woe_train[['NetFractionRevolvingBurden', 'MaxDelq2PublicRecLast12M', 'NumBank2NatlTradesWHighUtilization', 'PercentTradesWBalance', 'MSinceMostRecentInqexcl7days', 'PercentTradesNeverDelq', 'AverageMInFile', 'MSinceOldestTradeOpen', 'NumTrades60Ever2DerogPubRec', 'NumTrades90Ever2DerogPubRec', 'MSinceMostRecentDelq', 'MaxDelqEver', 'NumRevolvingTradesWBalance', 'NumInqLast6M', 'PercentInstallTrades', 'NumInqLast6Mexcl7days', 'NumSatisfactoryTrades', 'NumTotalTrades', 'NetFractionInstallBurden', 'NumTradesOpeninLast12M']]\ny = (woe_train['bad_flag'].astype(str) == '1').astype(int)\nmodel = LogisticRegression(max_iter=1000, solver='liblinear')\nmodel.fit(X, y)\npd = model.predict_proba(X)[:, 1]\nauc = roc_auc_score(y, pd)\nfactor = 20.0 / np.log(2)\nbase_odds = 50.0\noffset = 600.0 - factor * np.log(base_odds)\nscore = offset + factor * (model.intercept_[0] + X.to_numpy() @ model.coef_[0])\nprint('AUC', auc)\n",
